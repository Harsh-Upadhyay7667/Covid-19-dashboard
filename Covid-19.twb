          <datasources>
            <datasource caption='StatewiseTestingDetails (2)' name='federated.15u3efw1259jvw1ahi80e0f9pbfl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N' datatype='integer' name='[State Parameter]' param-domain-type='any' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15u3efw1259jvw1ahi80e0f9pbfl'>
            <column caption='positive rate' datatype='real' name='[Calculation_143481937203191811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Positive])/SUM([TotalSamples])*100' />
            </column>
            <column datatype='integer' name='[Negative]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='real' name='[Positive]' role='dimension' type='ordinal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Total Samples' datatype='real' name='[TotalSamples]' role='measure' type='quantitative' />
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
            <column-instance column='[Negative]' derivation='Sum' name='[sum:Negative:qk]' pivot='key' type='quantitative' />
            <column-instance column='[TotalSamples]' derivation='Sum' name='[sum:TotalSamples:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_143481937203191811]' derivation='User' name='[usr:Calculation_143481937203191811:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.15u3efw1259jvw1ahi80e0f9pbfl].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.15u3efw1259jvw1ahi80e0f9pbfl].[sum:Negative:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.15u3efw1259jvw1ahi80e0f9pbfl].[usr:Calculation_143481937203191811:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.15u3efw1259jvw1ahi80e0f9pbfl].[sum:TotalSamples:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.15u3efw1259jvw1ahi80e0f9pbfl].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.15u3efw1259jvw1ahi80e0f9pbfl].[sum:Negative:qk]&quot;</bucket>
              <bucket>&quot;[federated.15u3efw1259jvw1ahi80e0f9pbfl].[usr:Calculation_143481937203191811:qk]&quot;</bucket>
              <bucket>&quot;[federated.15u3efw1259jvw1ahi80e0f9pbfl].[sum:TotalSamples:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.15u3efw1259jvw1ahi80e0f9pbfl].[none:State:nk]'>
            <groupfilter count='[Parameters].[State Parameter]' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
